# LLM_PROVIDER=gemini | groq | openai
LLM_PROVIDER=gemini
# Set false to disable automatic failover to other configured providers
LLM_FALLBACK=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NOTION_API_KEY=
NOTION_DATABASE_ID=
DISCORD_BOT_TOKEN=
SEARCH_API_KEY=

# Optional
AGENT_PREFIX=
AGENT_MEMORY_PATH=data/memory.json
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=12
